---
import { actions } from "astro:actions";

const result = Astro.getActionResult(actions.contacto);

// Sin opción preseleccionada: antes se marcaba la 2.ª de cada grupo y el
// visitante podía enviar un presupuesto que nunca había elegido.
const groups = [
	{
		name: "servicio",
		title: "Servicio que necesitas",
		options: [
			"Desarrollo / Despliegue web",
			"Configuración de equipo / Homelab",
			"Diseño de API",
			"Diseño de base de datos",
			"Auditoría de seguridad y hardening",
			"Mantenimiento, actualizaciones, backups y soporte",
		],
	},
	{
		name: "timeline",
		title: "Plazo estimado del proyecto",
		options: ["Menos de 1 mes", "1-3 meses", "3-6 meses", "Flexible / Sin prisa"],
	},
	{
		name: "presupuesto",
		title: "Presupuesto",
		options: ["50 - 200 €", "200 - 500 €", "500 - 1500 €", "+ 1 500 €"],
	},
];
---

<section id="contacto" class="panel" aria-labelledby="contacto-titulo">
	<h2 id="contacto-titulo" class="panel-title">Contacto</h2>

	<form method="POST" action={"/" + actions.contacto + "#contacto"} class="flex flex-col gap-8">
		<fieldset>
			<legend class="legend">Información general</legend>
			<div class="grid gap-4 sm:grid-cols-2">
				<div>
					<label for="nombre" class="label">Nombre</label>
					<input id="nombre" type="text" name="nombre" autocomplete="name" class="field" required />
				</div>
				<div>
					<label for="email" class="label">Email</label>
					<input id="email" type="email" name="email" autocomplete="email" class="field" required />
				</div>
			</div>
		</fieldset>

		<fieldset>
			<legend class="legend">Detalles del proyecto</legend>
			<div class="flex flex-col gap-4">
				<div>
					<label for="proyecto" class="label">Nombre del proyecto</label>
					<input id="proyecto" type="text" name="proyecto" class="field" required />
				</div>
				<div>
					<label for="link" class="label">Web actual (opcional)</label>
					<input id="link" type="url" name="link" placeholder="https://" class="field" />
				</div>
				<div>
					<label for="descripcion" class="label">Descripción</label>
					<textarea id="descripcion" name="descripcion" rows="5" class="field min-h-32 resize-y" required></textarea>
				</div>
			</div>
		</fieldset>

		{
			groups.map((g) => (
				<fieldset>
					<legend class="legend">{g.title}</legend>
					<div class="flex flex-wrap gap-2">
						{g.options.map((opt) => (
							<label class="chip">
								<input type="radio" name={g.name} value={opt} class="sr-only" required />
								<span class="chip-face">{opt}</span>
							</label>
						))}
					</div>
				</fieldset>
			))
		}

		<div class="flex flex-col gap-4">
			<button type="submit" class="btn-primary w-full sm:w-fit">Enviar consulta</button>

			{
				result && !result.error && (
					<p role="status" class="border border-accent p-3 text-accent">
						Enviado. Te responderé pronto por email.
					</p>
				)
			}
			{
				result?.error && (
					<p role="alert" class="border border-accent-2 p-3 text-accent-2">
						No se pudo enviar. Revisa los campos e inténtalo de nuevo.
					</p>
				)
			}
		</div>
	</form>
</section>
