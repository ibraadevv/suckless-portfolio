---
const proyectos = [
	{ nombre: "CRR", descripcion: "Portfolio para la consultoría", url: "https://crrcultural.es", dominio: "crrcultural.es" },
	{ nombre: "David Sanchez Cruz", descripcion: "Web para el escultor", url: "https://davidsanchezcruz.es", dominio: "davidsanchezcruz.es" },
	{ nombre: "Warrior Soul FightSchool", descripcion: "Web para gimnasio", url: null, dominio: null },
];
---

<section id="proyectos" class="panel" aria-labelledby="proyectos-titulo">
	<h2 id="proyectos-titulo" class="panel-title">Proyectos</h2>

	<ul>
		{
			proyectos.map((p) => (
				<li class="grid gap-1 border-t border-line py-4 first:border-t-0 first:pt-0 last:pb-0 sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-x-6">
					<div>
						<h3>{p.nombre}</h3>
						<p class="text-ink-muted">{p.descripcion}</p>
					</div>
					{p.url ? (
						<a href={p.url} target="_blank" rel="noopener noreferrer" class="link self-start sm:self-auto">
							{p.dominio}
							<span class="sr-only"> (se abre en una pestaña nueva)</span>
						</a>
					) : (
						<span class="text-ink-muted">En desarrollo</span>
					)}
				</li>
			))
		}
	</ul>
</section>
